# Runtime logs and rotated copies
*.log
*.log.*
*.out
*.err
fai_stdout.log
fai_stderr.log
render.yaml.bak
Procfile.bak
_proc*.bak

# TLS material - never commit private keys or certificates
*.pem
*.key
*.crt
*.pfx
cert.pem
key.pem

# Generated / temporary diagnostics
_page_*.html
_js/
noart_preview.png
tb.txt
_check_js.py
_shot_srv.py
_png_check.py
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environments
venv/
.venv/
env/

# Editors and OS
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# Local overrides
local_settings.py
.env
# scratch commit-message files (they must never be committed)
_m.txt
_msg.txt
_mb.txt

# Local WIP / backups. LIBRARY-WRITE-WIP.txt holds the unverified library-write
# work that is deliberately NOT committed - see the commit message. These must
# never be staged, and the parked file documents a known-broken write path, so
# it would be wrong to publish it alongside the code it belongs to.
LIBRARY-WRITE-WIP.txt
all-work-backup.patch
*.bak

# PyInstaller build output. The exe is a release asset uploaded to GitHub
# Releases, not something to commit - it is ~16MB of binary that is
# reproducible with `python build_exe.py`.
build/
dist/
*.spec

# Generated by build_exe.py on every run - the version resource it feeds to
# PyInstaller. Reproducible from the build script, not source.
build_version.txt

# The Windows 7/8 TEST build (build_exe_win7.py). Kept in its own directories
# so that script's cleanup pass cannot reach the official build/ and dist/ - it
# wipes whatever it is pointed at before running. Same reasoning as the three
# entries above, for the same generated-artifact reasons.
dist-win7/
build-win7/
build_version_win7.txt

# Python 3.8 virtualenv for the Win7 build. Recreate it with the commands in
# build_exe_win7.py's docstring; committing a venv would drag ~40 MB of
# interpreter and site-packages into the repo.
.venv38/

# Scratch files written by the node --check regression tests. They are
# rewritten on every run and must never be committed.
_syntaxcheck_*.js
